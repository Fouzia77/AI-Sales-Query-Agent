# Optional Anthropic Claude API key. Leave empty for offline fallback mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional Ollama endpoint (example: http://host.docker.internal:11434).
# If configured, the app tries Anthropic first, then Ollama, then offline rules.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# SQLite database path inside the container.
DATABASE_URL=sqlite:///./data/sales.db
